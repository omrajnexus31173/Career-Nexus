# Required. Use a hosted Postgres database (Neon, Supabase, or Railway).
# Netlify does not provide PostgreSQL. Example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Optional. Without these, Nexus AI uses the built-in guidance engine and says so.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional. Without these, password-reset email is not sent. Recovery codes still work.
RESEND_API_KEY=
EMAIL_FROM=Career Nexus <no-reply@yourdomain.com>

CLOUDINARY_URL=


# Optional. Who may embed the site in an iframe. Default in code allows HTTPS parents.
# On your own domain, set this to: 'self'
FRAME_ANCESTORS=
